@startuml UC_10
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowColor #455A64
skinparam packageStyle rectangle
skinparam linetype polyline
skinparam nodesep 45
skinparam ranksep 80
skinparam usecase {
  BackgroundColor #FFF2B3
  BorderColor #8A6D00
  FontColor #202020
}
skinparam actor {
  BorderColor #37474F
  FontColor #202020
}
title UC-10: View Medication and Safety History

' Specification pre/post-conditions and flow details: SPECIFICATION-TRACE.md.
' include/extend are UML functional relationships, not execution-order arrows.
' A1..An correspond to the Alternative Flows of this UC.
actor "Patient / General User" as Actor1

usecase "Browse medication and\nsafety history" as History
usecase "View selected record\nor assessment" as Details
usecase "Identify outdated\nassessment results" as Current
usecase "A1: Show empty state\nand end" as A1 #FFE4C4
usecase "A2: Report limitation without\nexposing private data" as A2 #FFE4C4
usecase "Select another permitted record" as SelectOther

Actor1 -- History
Actor1 -- Details
Actor1 -- SelectOther
Details ..> Current : <<include>>
A1 ..> History : <<extend>>\n[No history available]
A2 ..> Details : <<extend>>\n[Record unavailable or access denied]
SelectOther ..> A2 : <<extend>>\n[patient chooses another record]

@enduml


