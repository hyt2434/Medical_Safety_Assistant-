@startuml UC_02
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowColor #455A64
skinparam packageStyle rectangle
skinparam linetype polyline
skinparam nodesep 45
skinparam ranksep 80
skinparam usecase {
  BackgroundColor #FFF2B3
  BorderColor #8A6D00
  FontColor #202020
}
skinparam actor {
  BorderColor #37474F
  FontColor #202020
}
title UC-02: Enter and Confirm Medication Information

' Specification pre/post-conditions and flow details: SPECIFICATION-TRACE.md.
' include/extend are UML functional relationships, not execution-order arrows.
' A1..An correspond to the Alternative Flows of this UC.
actor "Patient / General User" as Actor1

usecase "Enter medication information" as Entry
usecase "Process medication input" as Process
usecase "Review, correct and confirm\nmedication details" as Confirm
usecase "A1: Clarify request or\nselect a function" as A1 #FFE4C4
usecase "A2: Report processing error" as A2 #FFE4C4
usecase "A3: Identify incomplete fields\nand correct when possible" as A3 #FFE4C4
usecase "A4: Keep input unavailable for\nsafety checks and reminder activation" as A4 #FFE4C4
usecase "Resume input processing\n(step 2)" as Clarified
usecase "End unresolved request" as UnclearEnd
usecase "Retry or change input method\n(step 1)" as Retry
usecase "End input attempt" as Cancel
usecase "Save confirmed details\nwith remaining gaps marked" as Save
usecase "Upload image for OCR" as OCR
usecase "Enter chatbot text" as Text
usecase "Provide voice input" as Voice
usecase "Enter details manually" as Manual

Actor1 -- Entry
Actor1 -- Confirm
Actor1 -- Clarified
Actor1 -- Retry
Actor1 -- Cancel
Entry ..> Process : <<include>>
A1 ..> Process : <<extend>>\n[Unclear request]
A2 ..> Process : <<extend>>\n[Input processing fails]
A3 ..> Confirm : <<extend>>\n[Missing or unclear details]
A4 ..> Confirm : <<extend>>\n[Patient does not confirm]
Clarified ..> A1 : <<extend>>\n[request clarified]
UnclearEnd ..> A1 : <<extend>>\n[not clarified]
Retry ..> A2 : <<extend>>\n[patient retries]
Cancel ..> A2 : <<extend>>\n[patient cancels]
Save ..> Confirm : <<extend>>\n[patient confirms]
OCR -|> Entry
Text -|> Entry
Voice -|> Entry
Manual -|> Entry

@enduml


