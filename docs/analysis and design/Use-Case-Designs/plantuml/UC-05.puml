@startuml UC_05
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowColor #455A64
skinparam packageStyle rectangle
skinparam linetype polyline
skinparam nodesep 45
skinparam ranksep 80
skinparam usecase {
  BackgroundColor #FFF2B3
  BorderColor #8A6D00
  FontColor #202020
}
skinparam actor {
  BorderColor #37474F
  FontColor #202020
}
title UC-05: Review Medication Safety Case

' Specification pre/post-conditions and flow details: SPECIFICATION-TRACE.md.
' include/extend are UML functional relationships, not execution-order arrows.
' A1..An correspond to the Alternative Flows of this UC.
actor "Healthcare Professional (HCP)" as Actor1
actor "Patient / General User" as Actor2

usecase "Open queued case\nand conversation" as Case
usecase "Record simulated review\noutcome and reply" as Decision
usecase "Return case to permitted\nHCP review queue" as Queue
usecase "View outcome, reply\nand case status" as View
usecase "A1: Request missing details\nin the case conversation" as A1 #FFE4C4
usecase "A2: Submit follow-up question\nin the existing conversation" as A2 #FFE4C4
usecase "A3: Record unresolved reason\nand retain required reminder holds" as A3 #FFE4C4
usecase "A4: Keep affected new reminders Pending\nand show the restriction" as A4 #FFE4C4
usecase "A5: Deny or stop action\nwithout treating an unrecorded reply as approval" as A5 #FFE4C4
usecase "Mark Awaiting\nPatient Response" as Await
usecase "Submit missing information\nin the SAME thread" as Respond
usecase "Mark Pending HCP Response\nand show chronological reply thread" as Pending
usecase "Show new-patient-reply indication" as NewReply
usecase "Reopen case conversation\n(resume step 2)" as Reopen
usecase "Recheck affected\npending reminders" as Recheck

Actor1 -- Case
Actor1 -- Decision
Actor1 -- View
Actor2 -- View
Actor1 -- A1
Actor2 -- A2
Actor1 -- A3
Actor2 -- Respond
Actor1 -- Reopen
A1 ..> Await : <<include>>
Respond ..> Queue : <<include>>
A2 ..> Queue : <<include>>
Queue ..> Pending : <<include>>
A2 ..> NewReply : <<include>>
A1 ..> Decision : <<extend>>\n[Case needs more information]
A2 ..> View : <<extend>>\n[Patient asks follow-up after step 6]
A3 ..> Decision : <<extend>>\n[HCP selects Unresolved]
A4 ..> Decision : <<extend>>\n[No valid schedule confirmation]
A5 ..> Case : <<extend>>\n[Unauthorized or changed case, or save fails]
Respond ..> A1 : <<extend>>\n[patient responds]
Reopen ..> Queue : <<extend>>\n[HCP selects returned case]
Recheck ..> Decision : <<extend>>\n[eligible schedule confirmation recorded]

@enduml


