@startuml UC_12
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowColor #455A64
skinparam packageStyle rectangle
skinparam linetype polyline
skinparam nodesep 45
skinparam ranksep 80
skinparam usecase {
  BackgroundColor #FFF2B3
  BorderColor #8A6D00
  FontColor #202020
}
skinparam actor {
  BorderColor #37474F
  FontColor #202020
}
title UC-12: Generate Patient Health Summary

' Specification pre/post-conditions and flow details: SPECIFICATION-TRACE.md.
' include/extend are UML functional relationships, not execution-order arrows.
' A1..An correspond to the Alternative Flows of this UC.
actor "Patient / General User" as Actor1

usecase "Generate a patient\nhealth summary" as Generate
usecase "Gather permitted records\nand reported health details" as Gather
usecase "Review and confirm\nthe draft summary" as Review
usecase "A1: Label missing items\nand generate a limited draft" as A1 #FFE4C4
usecase "A2: Correct supported draft fields\nor source records" as A2 #FFE4C4
usecase "A3: Do not save or share\na new confirmed summary" as A3 #FFE4C4
usecase "Save confirmed summary\nwithout automatic sharing" as Save
usecase "Update draft and review again\n(step 4)" as ReviewAgain
usecase "Retry saving summary" as Retry

Actor1 -- Generate
Actor1 -- Review
Actor1 -- Retry
Generate ..> Gather : <<include>>
Generate ..> Review : <<include>>
A2 ..> ReviewAgain : <<include>>
A1 ..> Gather : <<extend>>\n[Information missing]
A2 ..> Review : <<extend>>\n[Draft needs correction]
A3 ..> Review : <<extend>>\n[Patient cancels or saving fails]
Save ..> Review : <<extend>>\n[patient confirms]
Retry ..> A3 : <<extend>>\n[save failed and patient retries]

@enduml


