@startuml UC_14
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowColor #455A64
skinparam packageStyle rectangle
skinparam linetype polyline
skinparam nodesep 45
skinparam ranksep 80
skinparam usecase {
  BackgroundColor #FFF2B3
  BorderColor #8A6D00
  FontColor #202020
}
skinparam actor {
  BorderColor #37474F
  FontColor #202020
}
title UC-14: Review Medication Dataset Record

' Specification pre/post-conditions and flow details: SPECIFICATION-TRACE.md.
' include/extend are UML functional relationships, not execution-order arrows.
' A1..An correspond to the Alternative Flows of this UC.
actor "Dataset Reviewer" as Actor1

usecase "Open a permitted\ndataset record" as Select
usecase "Compare medication record\nwith evidence" as Evidence
usecase "Record data-quality\nreview decision" as Decision
usecase "A1: Record missing evidence\nwithout claiming clinical validation" as A1 #FFE4C4
usecase "A2: Record mapping issue" as A2 #FFE4C4
usecase "A3: Reload latest record\nbefore deciding" as A3 #FFE4C4
usecase "A4: Save no new decision\nand retain previous review status" as A4 #FFE4C4
usecase "Choose Reject or Needs Correction\nand record reason" as Quality
usecase "Validate and save decision, reviewer,\ntime and evidence; update status" as Save
usecase "Review latest evidence\n(step 2)" as ReviewAgain

Actor1 -- Select
Actor1 -- Evidence
Actor1 -- Decision
A1 ..> Quality : <<include>>
A2 ..> Quality : <<include>>
A3 ..> ReviewAgain : <<include>>
A1 ..> Evidence : <<extend>>\n[Source evidence missing]
A2 ..> Evidence : <<extend>>\n[Inconsistent mapping found]
A3 ..> Decision : <<extend>>\n[Record changed during review]
A4 ..> Decision : <<extend>>\n[Reviewer cancels or saving fails]
Save ..> Decision : <<extend>>\n[valid decision and unchanged record]

@enduml


