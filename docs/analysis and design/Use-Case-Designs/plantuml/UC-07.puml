@startuml UC_07
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowColor #455A64
skinparam packageStyle rectangle
skinparam linetype polyline
skinparam nodesep 45
skinparam ranksep 80
skinparam usecase {
  BackgroundColor #FFF2B3
  BorderColor #8A6D00
  FontColor #202020
}
skinparam actor {
  BorderColor #37474F
  FontColor #202020
}
title UC-07: Manage Medication Reminders

' Specification pre/post-conditions and flow details: SPECIFICATION-TRACE.md.
' include/extend are UML functional relationships, not execution-order arrows.
' A1..An correspond to the Alternative Flows of this UC.
actor "Patient / General User" as Actor1

usecase "Manage an existing reminder" as Manage
usecase "Validate requested change\nagainst instructions and rules" as Validate
usecase "Confirm reminder change" as Confirm
usecase "A1: Prepare to disable only\nthe selected notification" as A1 #FFE4C4
usecase "A2: Require HCP review of new timing\nwhile preserving existing schedule" as A2 #FFE4C4
usecase "A3: Preserve previous settings\nand report save error when relevant" as A3 #FFE4C4
usecase "Save allowed notification setting" as SaveSetting
usecase "Save timing proposal\nas Pending HCP Review" as SaveProposal

Actor1 -- Manage
Actor1 -- Confirm
Manage ..> Validate : <<include>>
Manage ..> Confirm : <<include>>
A1 ..> Confirm : <<include>>
A2 ..> Confirm : <<include>>
A1 ..> Manage : <<extend>>\n[Patient disables notification]
A2 ..> Validate : <<extend>>\n[Timing differs from verified instructions]
A3 ..> Confirm : <<extend>>\n[Patient cancels or update fails]
SaveSetting ..> Confirm : <<extend>>\n[confirmed allowed change]
SaveProposal ..> Confirm : <<extend>>\n[confirmed timing change requires review]

@enduml


