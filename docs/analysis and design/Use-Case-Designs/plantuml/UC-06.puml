@startuml UC_06
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowColor #455A64
skinparam packageStyle rectangle
skinparam linetype polyline
skinparam nodesep 45
skinparam ranksep 80
skinparam usecase {
  BackgroundColor #FFF2B3
  BorderColor #8A6D00
  FontColor #202020
}
skinparam actor {
  BorderColor #37474F
  FontColor #202020
}
title UC-06: Set Up Medication Reminders

' Specification pre/post-conditions and flow details: SPECIFICATION-TRACE.md.
' include/extend are UML functional relationships, not execution-order arrows.
' A1..An correspond to the Alternative Flows of this UC.
actor "Patient / General User" as Actor1

usecase "Set up medication reminders" as Setup
usecase "Review and confirm\nrecorded schedule" as Confirm
usecase "Check schedule verification\nand safety gate" as Gate
usecase "View reminder status" as Status
usecase "A1: Keep reminder inactive\nuntil schedule is verified" as A1 #FFE4C4
usecase "A2: Record timing proposal\nas Pending HCP Review" as A2 #FFE4C4
usecase "A3: Hold affected NEW reminders\nas Pending HCP Review" as A3 #FFE4C4
usecase "A4: Report Unassessed status" as A4 #FFE4C4
usecase "A5: Report notification limitation\nand show eligible schedules in app" as A5 #FFE4C4
usecase "Activate eligible reminders" as Activate
usecase "Correct schedule information" as Correct
usecase "End setup attempt" as End
usecase "Keep proposed schedule inactive\nuntil simulated HCP confirmation" as NoProposed
usecase "Preserve existing reminders;\nallow other eligible new reminders" as Existing
usecase "Keep reminder restricted" as PolicyHold

Actor1 -- Setup
Actor1 -- Confirm
Actor1 -- Status
Actor1 -- Correct
Actor1 -- End
Setup ..> Confirm : <<include>>
Setup ..> Gate : <<include>>
A2 ..> NoProposed : <<include>>
A3 ..> Existing : <<include>>
A1 ..> Confirm : <<extend>>\n[Schedule missing or unverified]
A2 ..> Confirm : <<extend>>\n[Patient proposes new timing]
A3 ..> Gate : <<extend>>\n[Severe interaction affects medicine]
A4 ..> Gate : <<extend>>\n[Safety check unavailable]
A5 ..> Status : <<extend>>\n[Browser notifications unavailable]
Activate ..> Setup : <<extend>>\n[verified schedule and safety gate permits]
Correct ..> A1 : <<extend>>\n[patient corrects]
End ..> A1 : <<extend>>\n[patient ends]
PolicyHold ..> A4 : <<extend>>\n[review policy requires confirmation]

@enduml


