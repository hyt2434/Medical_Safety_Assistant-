@startuml UC_09
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowColor #455A64
skinparam packageStyle rectangle
skinparam linetype polyline
skinparam nodesep 45
skinparam ranksep 80
skinparam usecase {
  BackgroundColor #FFF2B3
  BorderColor #8A6D00
  FontColor #202020
}
skinparam actor {
  BorderColor #37474F
  FontColor #202020
}
title UC-09: View Adherence History

' Specification pre/post-conditions and flow details: SPECIFICATION-TRACE.md.
' include/extend are UML functional relationships, not execution-order arrows.
' A1..An correspond to the Alternative Flows of this UC.
actor "Patient / General User" as Actor1

usecase "View adherence history" as History
usecase "Select medicine or time period" as Filter
usecase "A1: Show empty result" as A1 #FFE4C4
usecase "A2: Show available records\nand identify unavailable periods" as A2 #FFE4C4
usecase "Select another filter" as Refilter

Actor1 -- History
Actor1 -- Filter
Actor1 -- Refilter
History ..> Filter : <<include>>
A1 ..> Filter : <<extend>>\n[No entries match]
A2 ..> History : <<extend>>\n[History incomplete or unavailable]
Refilter ..> A1 : <<extend>>\n[patient changes filter]

@enduml


