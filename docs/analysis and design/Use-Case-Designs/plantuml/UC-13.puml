@startuml UC_13
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowColor #455A64
skinparam packageStyle rectangle
skinparam linetype polyline
skinparam nodesep 45
skinparam ranksep 80
skinparam usecase {
  BackgroundColor #FFF2B3
  BorderColor #8A6D00
  FontColor #202020
}
skinparam actor {
  BorderColor #37474F
  FontColor #202020
}
title UC-13: Share Patient Health Summary with HCP

' Specification pre/post-conditions and flow details: SPECIFICATION-TRACE.md.
' include/extend are UML functional relationships, not execution-order arrows.
' A1..An correspond to the Alternative Flows of this UC.
actor "Patient / General User" as Actor1

usecase "Share a saved summary\nwith an authorized HCP" as Share
usecase "Review summary and\nrecipient or case" as Select
usecase "Confirm sharing scope\nand permission" as Consent
usecase "Grant scoped summary access" as Access
usecase "A1: End without granting\nnew access" as A1 #FFE4C4
usecase "A2: Deny sharing and request\nan authorized target" as A2 #FFE4C4
usecase "A3: Warn about summary date\nor missing information" as A3 #FFE4C4
usecase "A4: Report failure without claiming success\nor creating unintended access" as A4 #FFE4C4
usecase "Show sharing status" as Status
usecase "Choose authorized target\n(step 2)" as Reselect
usecase "Cancel sharing" as Cancel
usecase "Share with visible limits" as Limited
usecase "Return to Generate\nPatient Health Summary (UC-12)" as Regenerate

Actor1 -- Share
Actor1 -- Select
Actor1 -- Consent
Actor1 -- Reselect
Actor1 -- Cancel
Actor1 -- Limited
Actor1 -- Regenerate
Share ..> Select : <<include>>
Share ..> Consent : <<include>>
Share ..> Access : <<include>>
Share ..> Status : <<include>>
A1 ..> Consent : <<extend>>\n[Permission declined]
A2 ..> Access : <<extend>>\n[Recipient or case unauthorized]
A3 ..> Select : <<extend>>\n[Summary outdated]
A4 ..> Access : <<extend>>\n[Sharing fails]
Reselect ..> A2 : <<extend>>\n[patient retries]
Cancel ..> A2 : <<extend>>\n[patient cancels]
Limited ..> A3 : <<extend>>\n[patient accepts limits]
Regenerate ..> A3 : <<extend>>\n[patient chooses regeneration]

@enduml


