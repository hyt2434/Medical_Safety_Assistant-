@startuml UC_17
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowColor #455A64
skinparam packageStyle rectangle
skinparam linetype polyline
skinparam nodesep 45
skinparam ranksep 80
skinparam usecase {
  BackgroundColor #FFF2B3
  BorderColor #8A6D00
  FontColor #202020
}
skinparam actor {
  BorderColor #37474F
  FontColor #202020
}
title UC-17: Report Technical Issue

' Specification pre/post-conditions and flow details: SPECIFICATION-TRACE.md.
' include/extend are UML functional relationships, not execution-order arrows.
' A1..An correspond to the Alternative Flows of this UC.
actor "Registered User" as Actor1

usecase "Report a technical issue" as Report
usecase "Describe issue and\nreview attachments" as Details
usecase "Submit report and receive\nticket identifier and status" as Submit
usecase "A1: Highlight missing fields" as A1 #FFE4C4
usecase "A2: Remove or mask unnecessary\npatient data before submission" as A2 #FFE4C4
usecase "A3: Report no successful submission\nand create no ticket" as A3 #FFE4C4
usecase "Complete required information\n(step 3)" as Complete
usecase "Review description and attachments\n(step 3)" as ReviewAgain
usecase "Retry ticket submission" as Retry
usecase "End report attempt" as End

Actor1 -- Report
Actor1 -- Details
Actor1 -- Submit
Actor1 -- Complete
Actor1 -- Retry
Actor1 -- End
Report ..> Details : <<include>>
A2 ..> ReviewAgain : <<include>>
A1 ..> Submit : <<extend>>\n[Required information missing]
A2 ..> Details : <<extend>>\n[Unnecessary patient information attached]
A3 ..> Submit : <<extend>>\n[User cancels or ticket creation fails]
Complete ..> A1 : <<extend>>\n[user corrects]
Retry ..> A3 : <<extend>>\n[creation failed and user retries]
End ..> A3 : <<extend>>\n[user ends]

@enduml


