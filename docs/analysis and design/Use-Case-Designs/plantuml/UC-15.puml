@startuml UC_15
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowColor #455A64
skinparam packageStyle rectangle
skinparam linetype polyline
skinparam nodesep 45
skinparam ranksep 80
skinparam usecase {
  BackgroundColor #FFF2B3
  BorderColor #8A6D00
  FontColor #202020
}
skinparam actor {
  BorderColor #37474F
  FontColor #202020
}
title UC-15: Manage User Accounts and Roles

' Specification pre/post-conditions and flow details: SPECIFICATION-TRACE.md.
' include/extend are UML functional relationships, not execution-order arrows.
' A1..An correspond to the Alternative Flows of this UC.
actor "Administrator" as Actor1

usecase "Manage accounts and roles" as Manage
usecase "Create an account" as Create
usecase "Update account details,\nstatus or roles" as Update
usecase "Validate account and\nRBAC rules" as Validate
usecase "Confirm proposed change" as Confirm
usecase "A1: Explain invalid or\nduplicate account data" as A1 #FFE4C4
usecase "A2: Deny request without\ngranting extra permissions" as A2 #FFE4C4
usecase "A3: Retain prior account and role settings\nand report save error when relevant" as A3 #FFE4C4
usecase "Correct account information\n(step 3)" as Correct
usecase "Cancel account change" as Cancel
usecase "Select another permitted action" as Another
usecase "Save authorized change\nand administrative activity" as Save

Actor1 -- Manage
Actor1 -- Create
Actor1 -- Update
Actor1 -- Confirm
Actor1 -- Correct
Actor1 -- Cancel
Actor1 -- Another
Manage ..> Validate : <<include>>
Manage ..> Confirm : <<include>>
A1 ..> Validate : <<extend>>\n[Invalid data or duplicate account]
A2 ..> Validate : <<extend>>\n[Action or role change not permitted]
A3 ..> Confirm : <<extend>>\n[Administrator cancels or save fails]
Correct ..> A1 : <<extend>>\n[administrator corrects]
Cancel ..> A1 : <<extend>>\n[administrator cancels]
Another ..> A2 : <<extend>>\n[administrator continues]
Save ..> Confirm : <<extend>>\n[confirmed valid request]
Create -|> Manage
Update -|> Manage

@enduml


