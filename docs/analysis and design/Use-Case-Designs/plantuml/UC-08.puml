@startuml UC_08
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowColor #455A64
skinparam packageStyle rectangle
skinparam linetype polyline
skinparam nodesep 45
skinparam ranksep 80
skinparam usecase {
  BackgroundColor #FFF2B3
  BorderColor #8A6D00
  FontColor #202020
}
skinparam actor {
  BorderColor #37474F
  FontColor #202020
}
title UC-08: Record Dose Status

' Specification pre/post-conditions and flow details: SPECIFICATION-TRACE.md.
' include/extend are UML functional relationships, not execution-order arrows.
' A1..An correspond to the Alternative Flows of this UC.
actor "Patient / General User" as Actor1

usecase "Record scheduled dose status" as Record
usecase "Review and confirm\ndose entry" as Confirm
usecase "A1: Compare previous dose status\nand confirm correction" as A1 #FFE4C4
usecase "A2: Keep previous entry\nand end" as A2 #FFE4C4
usecase "A3: Explain save failure\nand create no unsupported dose record" as A3 #FFE4C4
usecase "Save confirmed dose status\nand recorded time" as Save
usecase "Save confirmed correction\n(step 5)" as SaveCorrection

Actor1 -- Record
Actor1 -- Confirm
Record ..> Confirm : <<include>>
A1 ..> SaveCorrection : <<include>>
A1 ..> Record : <<extend>>\n[Existing entry is corrected]
A2 ..> Confirm : <<extend>>\n[Patient cancels]
A3 ..> Record : <<extend>>\n[Dose event unavailable or save fails]
Save ..> Confirm : <<extend>>\n[patient confirms]

@enduml


