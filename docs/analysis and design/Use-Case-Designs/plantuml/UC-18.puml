@startuml UC_18
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowColor #455A64
skinparam packageStyle rectangle
skinparam linetype polyline
skinparam nodesep 45
skinparam ranksep 80
skinparam usecase {
  BackgroundColor #FFF2B3
  BorderColor #8A6D00
  FontColor #202020
}
skinparam actor {
  BorderColor #37474F
  FontColor #202020
}
title UC-18: Handle Technical Support Request

' Specification pre/post-conditions and flow details: SPECIFICATION-TRACE.md.
' include/extend are UML functional relationships, not execution-order arrows.
' A1..An correspond to the Alternative Flows of this UC.
actor "Technical Support" as Actor1

usecase "Open a permitted\nsupport ticket" as Open
usecase "Investigate and record\ntroubleshooting notes" as Investigate
usecase "Record resolution\nor progress status" as Update
usecase "A1: Request necessary technical details\nand set Pending User Response" as A1 #FFE4C4
usecase "A2: Record progress and keep\nticket Open or In Progress" as A2 #FFE4C4
usecase "A3: Restrict medical content\nand use permitted technical details" as A3 #FFE4C4
usecase "A4: Deny action or report error\nwithout unsupported resolution" as A4 #FFE4C4
usecase "Save action, time and staff account;\nshow reporter the updated status" as Save
usecase "End current handling attempt" as End
usecase "Continue to save update\n(step 5)" as Continue

Actor1 -- Open
Actor1 -- Investigate
Actor1 -- Update
A1 ..> End : <<include>>
A2 ..> Continue : <<include>>
A1 ..> Investigate : <<extend>>\n[More information required]
A2 ..> Update : <<extend>>\n[Issue unresolved]
A3 ..> Investigate : <<extend>>\n[Unauthorized patient data present]
A4 ..> Open : <<extend>>\n[Access denied or saving fails]
Save ..> Update : <<extend>>\n[authorized update saves successfully]

@enduml


