@startuml UC_03
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowColor #455A64
skinparam packageStyle rectangle
skinparam linetype polyline
skinparam nodesep 45
skinparam ranksep 80
skinparam usecase {
  BackgroundColor #FFF2B3
  BorderColor #8A6D00
  FontColor #202020
}
skinparam actor {
  BorderColor #37474F
  FontColor #202020
}
title UC-03: Check Medication Safety

' Specification pre/post-conditions and flow details: SPECIFICATION-TRACE.md.
' include/extend are UML functional relationships, not execution-order arrows.
' A1..An correspond to the Alternative Flows of this UC.
actor "Patient / General User" as Actor1

usecase "Check medication safety" as Check
usecase "Identify medicines\nand active ingredients" as Identify
usecase "Check supported\ndrug-drug interactions" as Interactions
usecase "Check duplicate\nactive ingredients" as Duplicates
usecase "View findings, risk levels\nand assessment limits" as Results
usecase "A1: Mark medicine unresolved\nwithout guessing ingredients" as A1 #FFE4C4
usecase "A2: Mark affected checks unassessed\nand run independent supported checks" as A2 #FFE4C4
usecase "A3: Show severe warning immediately\nand recommend prompt HCP review" as A3 #FFE4C4
usecase "A4: Determine pairwise-check\napplicability and coverage" as A4 #FFE4C4
usecase "A5: Report failed or incomplete assessment\nand retain recorded warnings and holds" as A5 #FFE4C4
usecase "Record assessment status,\nfindings, coverage and time" as Record
usecase "Run assessable checks only" as Assessable
usecase "Report unassessed result\n(step 4)" as Unassessed
usecase "Hold affected NEW reminders only;\nexisting treatment and reminders unchanged" as Hold
usecase "Continue remaining checks\n(step 4)" as Continue
usecase "Mark pairwise checks\nnot applicable" as NotApplicable
usecase "Mark unresolved-medicine\nchecks unassessed" as UnresolvedPairs
usecase "Retry assessment\n(step 1)" as Retry
usecase "End failed assessment" as End

Actor1 -- Check
Actor1 -- Results
Actor1 -- Retry
Actor1 -- End
Check ..> Identify : <<include>>
Check ..> Record : <<include>>
A3 ..> Hold : <<include>>
A3 ..> Continue : <<include>>
A1 ..> Identify : <<extend>>\n[Medicine cannot be identified]
A2 ..> Interactions : <<extend>>\n[Required interaction data missing]
A3 ..> Interactions : <<extend>>\n[Severe interaction found]
A4 ..> Interactions : <<extend>>\n[Fewer than two identified medicines]
A5 ..> Check : <<extend>>\n[Assessment fails during steps 2-4]
Interactions ..> Check : <<extend>>\n[supported data and assessable medicines]
Duplicates ..> Check : <<extend>>\n[identified ingredients available]
Assessable ..> A1 : <<extend>>\n[independent checks possible]
Unassessed ..> A1 : <<extend>>\n[no checks assessable]
NotApplicable ..> A4 : <<extend>>\n[only one medicine supplied]
UnresolvedPairs ..> A4 : <<extend>>\n[other medicines unresolved]
Retry ..> A5 : <<extend>>\n[patient retries]
End ..> A5 : <<extend>>\n[patient ends]

@enduml


