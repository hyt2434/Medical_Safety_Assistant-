@startuml UC_04
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowColor #455A64
skinparam packageStyle rectangle
skinparam linetype polyline
skinparam nodesep 45
skinparam ranksep 80
skinparam usecase {
  BackgroundColor #FFF2B3
  BorderColor #8A6D00
  FontColor #202020
}
skinparam actor {
  BorderColor #37474F
  FontColor #202020
}
title UC-04: Request HCP Review

' Specification pre/post-conditions and flow details: SPECIFICATION-TRACE.md.
' include/extend are UML functional relationships, not execution-order arrows.
' A1..An correspond to the Alternative Flows of this UC.
actor "Patient / General User" as Actor1

usecase "Request review of a saved\nmedication safety case" as Request
usecase "Review case and grant\nsharing permission" as Share
usecase "View review request status" as Status
usecase "A1: End without a request\nor new sharing access" as A1 #FFE4C4
usecase "A2: Highlight missing or\nunresolved details" as A2 #FFE4C4
usecase "A3: Keep request Pending\nand unassigned" as A3 #FFE4C4
usecase "A4: Show existing request and status\nwithout duplicates or extra sharing" as A4 #FFE4C4
usecase "A5: Report failure and\ngrant no new access" as A5 #FFE4C4
usecase "Create Pending request\nwith authorized HCP access" as Create
usecase "Share clearly limited case" as Limited
usecase "End to update case details" as Update
usecase "Retry saving request\n(step 4)" as Retry
usecase "End request attempt" as End

Actor1 -- Request
Actor1 -- Share
Actor1 -- Status
Actor1 -- Limited
Actor1 -- Update
Actor1 -- Retry
Actor1 -- End
Request ..> Share : <<include>>
A1 ..> Share : <<extend>>\n[Sharing permission declined]
A2 ..> Share : <<extend>>\n[Case incomplete]
A3 ..> Request : <<extend>>\n[No reviewer available]
A4 ..> Request : <<extend>>\n[Active request already exists]
A5 ..> Request : <<extend>>\n[Request cannot be saved]
Create ..> Request : <<extend>>\n[permission and minimum data; no active request]
Limited ..> A2 : <<extend>>\n[minimum data exists and patient agrees]
Update ..> A2 : <<extend>>\n[patient chooses to update]
Retry ..> A5 : <<extend>>\n[patient retries]
End ..> A5 : <<extend>>\n[patient ends]

@enduml


