@startuml UC_11
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowColor #455A64
skinparam packageStyle rectangle
skinparam linetype polyline
skinparam nodesep 45
skinparam ranksep 80
skinparam usecase {
  BackgroundColor #FFF2B3
  BorderColor #8A6D00
  FontColor #202020
}
skinparam actor {
  BorderColor #37474F
  FontColor #202020
}
title UC-11: Ask a Medication Question

' Specification pre/post-conditions and flow details: SPECIFICATION-TRACE.md.
' include/extend are UML functional relationships, not execution-order arrows.
' A1..An correspond to the Alternative Flows of this UC.
actor "Patient / General User" as Actor1

usecase "Ask a medication question" as Ask
usecase "Identify request and\nauthorized context" as Context
usecase "Consult supported information\nand permitted records" as References
usecase "A1: Ask a short\nclarification question" as A1 #FFE4C4
usecase "A2: Explain information limits\nwithout inventing medical claims" as A2 #FFE4C4
usecase "A3: Warn to seek qualified\nor emergency help" as A3 #FFE4C4
usecase "A4: Open separate\nconfirmation use case" as A4 #FFE4C4
usecase "Provide supported answer\nwith explanations and limits" as Answer
usecase "Resume request identification\n(step 2)" as Clarified
usecase "End unclear request" as End
usecase "Ask another question" as Another
usecase "Require confirmation\nbefore changing any records" as NoChange

Actor1 -- Ask
Actor1 -- Clarified
Actor1 -- Another
Ask ..> Context : <<include>>
A4 ..> NoChange : <<include>>
A1 ..> Context : <<extend>>\n[Question unclear]
A2 ..> References : <<extend>>\n[Reliable information unavailable]
A3 ..> Context : <<extend>>\n[Outside scope or urgent danger]
A4 ..> Ask : <<extend>>\n[Request would modify records]
References ..> Ask : <<extend>>\n[supported request requires reference lookup]
Answer ..> Ask : <<extend>>\n[sufficient reliable information]
Clarified ..> A1 : <<extend>>\n[patient clarifies]
End ..> A1 : <<extend>>\n[not clarified]
Another ..> A2 : <<extend>>\n[patient continues]

@enduml


