@startuml UC_01
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowColor #455A64
skinparam packageStyle rectangle
skinparam linetype polyline
skinparam nodesep 45
skinparam ranksep 80
skinparam usecase {
  BackgroundColor #FFF2B3
  BorderColor #8A6D00
  FontColor #202020
}
skinparam actor {
  BorderColor #37474F
  FontColor #202020
}
title UC-01: Sign In

' Specification pre/post-conditions and flow details: SPECIFICATION-TRACE.md.
' include/extend are UML functional relationships, not execution-order arrows.
' A1..An correspond to the Alternative Flows of this UC.
actor "Registered User" as Actor1

usecase "Sign in" as Login
usecase "Validate credentials\nand account status" as Credentials
usecase "Verify role and permissions" as Permissions
usecase "A1: Reject credentials\nwithout creating a session" as A1 #FFE4C4
usecase "A2: Deny sign-in and advise\ncontacting support" as A2 #FFE4C4
usecase "A3: Deny access without\ncreating a session" as A3 #FFE4C4
usecase "Create session and open\npermitted dashboard" as Session
usecase "Retry sign-in\n(step 1)" as Retry
usecase "Cancel sign-in" as Cancel

Actor1 -- Login
Actor1 -- Retry
Actor1 -- Cancel
Login ..> Credentials : <<include>>
Login ..> Permissions : <<include>>
A1 ..> Credentials : <<extend>>\n[Incorrect credentials]
A2 ..> Credentials : <<extend>>\n[Inactive or blocked account]
A3 ..> Permissions : <<extend>>\n[Role information unavailable]
Session ..> Login : <<extend>>\n[credentials, account and role verified]
Retry ..> A1 : <<extend>>\n[user retries]
Cancel ..> A1 : <<extend>>\n[user cancels]

@enduml


